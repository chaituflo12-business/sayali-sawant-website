# Public site origin, used for canonical URLs, OG images and manage links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and anon key. The anon key only reads public availability.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for booking to work: book / reschedule / cancel / rate-limit RPCs are
# granted to service_role only, so without this key the booking form returns
# NOT_CONFIGURED and the rate limiter fails closed in production.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for outbound webhook signatures (also salts the rate-limit IP hash).
WEBHOOK_SECRET=

# Make.com custom webhook URL that receives every outbox event.
AUTOMATION_WEBHOOK_URL=

# Bearer token Make.com must send to read /api/upcoming, /api/waitlist and to
# post /api/message-status. Generate with: openssl rand -hex 32
MAKE_READ_TOKEN=

# Doctor's WhatsApp in E.164, receives the 06:45 IST daily digest.
DOCTOR_WHATSAPP=

# Reception / ops WhatsApp in E.164, receives error-route alerts.
OPS_WHATSAPP=

# AiSensy API key. Documentation only: this app never calls AiSensy, Make does.
AISENSY_API_KEY=

# Prefix for AiSensy campaign names, e.g. "ss_" gives ss_appt_reminder_24h.
AISENSY_CAMPAIGN_PREFIX=
